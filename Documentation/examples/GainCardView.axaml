<cards:PopoutCardBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="clr-namespace:MOSAIC.Views.Cards"
    xmlns:controls="clr-namespace:MOSAIC.Controls;assembly=MOSAIC"
    xmlns:converters="clr-namespace:MOSAIC.Converters;assembly=MOSAIC"
    xmlns:vm="clr-namespace:MOSAIC.ViewModels.SignalProcessing"
    x:Class="MOSAIC.Views.Cards.SignalProcessing.GainCardView"
    x:DataType="vm:GainViewModel">

    <cards:PopoutCardBase.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
    </cards:PopoutCardBase.Resources>

    <Border Classes="card" MinHeight="220">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="cardTitle" Text="{Binding Block.Name}"/>
                        <Border Background="{StaticResource CategorySignalProcessingBrush}"
                                CornerRadius="4" Padding="6,2">
                            <TextBlock Text="GAIN" FontSize="10" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="cardSubtitle" Text="{Binding Block.FrequencyText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding Block.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Block.Status}" FontSize="10"
                               FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <Border Classes="cardSection">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionLabel" Text="CONFIGURATION"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Gain:"
                                   VerticalAlignment="Center"/>
                        <controls:SafeNumericUpDown Grid.Column="1"
                                                    Value="{Binding Gain, Mode=TwoWay}"
                                                    Minimum="-1000000" Maximum="1000000"
                                                    Increment="0.1" FormatString="F3"/>
                        <Button Grid.Column="2" Content="Apply"
                                Command="{Binding ApplyCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</cards:PopoutCardBase>
