<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <DefineConstants>$(DefineConstants);APPLE_BLE</DefineConstants>
        <ApplicationId Condition="'$(ApplicationId)' == ''">AIROB-LAB.MOSAIC-2-0</ApplicationId>
        <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- Keep assembly processing enabled so the registrar emits AppDelegate's native
         constructor. TrimMode=copy omitted it with this SDK, leaving the generic
         Avalonia base constructor to handle iOS startup. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <UseInterpreter>true</UseInterpreter>
        <TrimMode>partial</TrimMode>
        <Registrar>managed-static</Registrar>
        <CodesignKey>iPhone Developer</CodesignKey>
    </PropertyGroup>

    <!-- Preserve reflection-based block/view discovery without disabling the
         registrar's assembly processing. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <TrimmerRootAssembly Include="MOSAIC" />
        <TrimmerRootAssembly Include="MOSAIC.iOS" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" />
        <PackageReference Include="FftFlat" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
        <PackageReference Include="ScottPlot" />
        <PackageReference Include="ScottPlot.Avalonia" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <!-- Preserve SerialPort type loading during shared block discovery. Opening a
             desktop serial port is not supported on iPad; BLE uses CoreBluetooth. -->
        <PackageReference Include="System.IO.Ports" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MOSAIC\MOSAIC.Mobile.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\MOSAIC\Components\Manager\BLE\AppleBackend.cs"
                 Link="Components\Manager\BLE\AppleBackend.cs" />
    </ItemGroup>
</Project>
