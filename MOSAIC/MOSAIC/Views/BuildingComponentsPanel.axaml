<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
             xmlns:controls="clr-namespace:MOSAIC.Controls"
             x:Class="MOSAIC.Views.BuildingComponentsPanel"
             x:Name="Panel"
             x:CompileBindings="False">

    <DockPanel Background="{DynamicResource ThemeBackgroundAltBrush}" LastChildFill="True">

        <!-- Header -->
        <Border Background="{DynamicResource ThemeAccentBrush}" Height="50" DockPanel.Dock="Top" Padding="0,0,16,0">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Width="50" Height="50"
                        Click="OnCloseClicked"
                        BorderThickness="0"
                        Background="Transparent"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="122.878" Height="122.88">
                            <Path Fill="White"
                                  Data="M1.426,8.313c-1.901-1.901-1.901-4.984,0-6.886c1.901-1.902,4.984-1.902,6.886,0l53.127,53.127l53.127-53.127 c1.901-1.902,4.984-1.902,6.887,0c1.901,1.901,1.901,4.985,0,6.886L68.324,61.439l53.128,53.128c1.901,1.901,1.901,4.984,0,6.886 c-1.902,1.902-4.985,1.902-6.887,0L61.438,68.326L8.312,121.453c-1.901,1.902-4.984,1.902-6.886,0 c-1.901-1.901-1.901-4.984,0-6.886l53.127-53.128L1.426,8.313L1.426,8.313z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="Building Components"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White" />
            </Grid>
        </Border>

        <!-- Resize Grip (left side) -->
        <primitives:Thumb x:Name="ResizeGrip"
                          DockPanel.Dock="Left"
                          Width="6"
                          Cursor="SizeWestEast"
                          ZIndex="1"
                          DragDelta="OnResizeDragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Border HorizontalAlignment="Right"
                                    Width="1"
                                    Background="{DynamicResource ThemeBorderBrush}" />

                            <StackPanel x:Name="GripStack"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="3"
                                        Opacity="0.5">
                                <Border Width="2" Height="16" Background="{DynamicResource ThemeTextMutedBrush}" CornerRadius="1" />
                                <Border Width="2" Height="16" Background="{DynamicResource ThemeTextMutedBrush}" CornerRadius="1" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>

        <!-- Content -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ModelFilesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="False" Padding="0" Margin="0" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding GroupName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource ThemeAccentBrush}"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}"
                                                   FontSize="12"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Files}" Margin="0" Padding="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <Expander IsExpanded="False" Padding="0" Margin="0" HorizontalAlignment="Stretch"
                                                      Expanded="OnModelFileExpanderExpanded">
                                                <Expander.Header>
                                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,8">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                   Margin="10,0,0,0"/>
                                                        <Button Grid.Column="1"
                                                                Width="28" Height="28"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                IsVisible="False"
                                                                Tag="AddButton"
                                                                Click="OnAddBlockClicked"
                                                                VerticalContentAlignment="Center"
                                                                HorizontalContentAlignment="Center">
                                                            <Viewbox Width="20" Height="20">
                                                                <Canvas Width="122.88" Height="119.72">
                                                                    <Path Fill="#22C55E"
                                                                          Data="M22.72,0h77.45c6.25,0,11.93,2.56,16.05,6.67c4.11,4.11,6.67,9.79,6.67,16.05v74.29c0,6.25-2.56,11.93-6.67,16.05 l-0.32,0.29c-4.09,3.94-9.64,6.38-15.73,6.38H22.72c-6.25,0-11.93-2.56-16.05-6.67l-0.3-0.32C2.43,108.64,0,103.09,0,97.01V22.71 c0-6.25,2.55-11.93,6.67-16.05C10.78,2.55,16.46,0,22.72,0L22.72,0z M55.47,38.34c0-3.3,2.67-5.97,5.97-5.97 c3.3,0,5.97,2.67,5.97,5.97v15.55h15.55c3.3,0,5.97,2.67,5.97,5.97c0,3.3-2.67,5.97-5.97,5.97H67.41v15.55 c0,3.3-2.67,5.97-5.97,5.97c-3.3,0-5.97-2.67-5.97-5.97V65.83H39.91c-3.3,0-5.97-2.67-5.97-5.97c0-3.3,2.67-5.97,5.97-5.97h15.55 V38.34L55.47,38.34z M100.16,10.24H22.72c-3.43,0-6.54,1.41-8.81,3.67c-2.26,2.26-3.67,5.38-3.67,8.81v74.29 c0,3.33,1.31,6.35,3.43,8.59l0.24,0.22c2.26,2.26,5.38,3.67,8.81,3.67h77.45c3.32,0,6.35-1.31,8.59-3.44l0.21-0.23 c2.26-2.26,3.67-5.38,3.67-8.81V22.71c0-3.42-1.41-6.54-3.67-8.81C106.71,11.65,103.59,10.24,100.16,10.24L100.16,10.24z"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </Expander.Header>
                                                <!-- Expandable Form -->
                                                <Border Background="{DynamicResource ThemeSurfaceBrush}"
                                                        CornerRadius="8"
                                                        Margin="12,8,12,12"
                                                        Padding="16">
                                                    <StackPanel Spacing="12">
                                                        <!-- Name Input -->
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Name"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                                            <TextBox Watermark="Enter name..."
                                                                     Text="{Binding Name, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <!-- Desired Rate Input -->
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Desired Rate"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                                            <controls:SafeNumericUpDown Minimum="0"
                                                                           Maximum="10000"
                                                                           Value="200"
                                                                           Increment="10"
                                                                           FormatString="N0"/>
                                                        </StackPanel>
                                                        <!-- Input Blocks Multi-Select -->
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Input Blocks"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    MaxHeight="120">
                                                                <Panel>
                                                                    <!-- Empty state message -->
                                                                    <TextBlock Text="No blocks on scene"
                                                                               FontSize="12"
                                                                               FontStyle="Italic"
                                                                               Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Margin="8"
                                                                               IsVisible="{Binding !#Panel.Blocks.Count}"/>
                                                                    <!-- Block checkboxes -->
                                                                    <ScrollViewer IsVisible="{Binding !!#Panel.Blocks.Count}">
                                                                        <ItemsControl ItemsSource="{Binding #Panel.Blocks}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox Content="{Binding Name}"
                                                                                              Margin="0,2"
                                                                                              IsCheckedChanged="OnInputBlockChecked"/>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Panel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Expander>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

    <UserControl.Styles>
        <!-- Resize grip styles -->
        <Style Selector="primitives|Thumb#ResizeGrip">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="primitives|Thumb#ResizeGrip:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
        <Style Selector="primitives|Thumb#ResizeGrip:pointerover /template/ StackPanel#GripStack">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="primitives|Thumb#ResizeGrip:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentMutedBrush}" />
        </Style>
        <Style Selector="primitives|Thumb#ResizeGrip:pressed /template/ StackPanel#GripStack">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>
</UserControl>
