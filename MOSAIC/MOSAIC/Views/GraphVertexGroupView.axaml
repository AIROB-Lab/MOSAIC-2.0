<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MOSAIC.Converters"
    xmlns:graph="clr-namespace:MOSAIC.ViewModels.Graph"
    x:DataType="graph:VertexGroupViewModel"
    x:Class="MOSAIC.Views.GraphVertexGroupView">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>
    
    <!-- Subsystem group node — double-border "container" look -->
    <Border x:Name="RootBorder"
            CornerRadius="12"
            BorderThickness="3"
            BorderBrush="{Binding AggregateStatus, Converter={StaticResource StatusToColor}}"
            Background="{DynamicResource ThemeCanvasNodeBrush}"
            BoxShadow="0 3 12 0 #50000000"
            Padding="0">

        <!-- Inner border gives the "subsystem container" feel -->
        <Border CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                Margin="3"
                Padding="10,6"
                Background="Transparent"
                Opacity="0.5">
            
            <Grid RowDefinitions="Auto,Auto,Auto" MinWidth="140">
                
                <!-- Row 0: Group icon + name (display) / edit field -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center">
                    <!-- Subsystem icon (layered squares) -->
                    <Panel Width="14" Height="14" Margin="0,1,0,0">
                        <Border Width="10" Height="10"
                                BorderThickness="1.5"
                                BorderBrush="{Binding AggregateStatus, Converter={StaticResource StatusToColor}}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Opacity="0.5"/>
                        <Border Width="10" Height="10"
                                BorderThickness="1.5"
                                BorderBrush="{Binding AggregateStatus, Converter={StaticResource StatusToColor}}"
                                CornerRadius="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"/>
                    </Panel>
                    
                    <!-- Display mode: name label -->
                    <TextBlock x:Name="NameLabel"
                               Text="{Binding Name}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    
                    <!-- Edit mode: name textbox (hidden by default) -->
                    <TextBox x:Name="NameEditor"
                             Text="{Binding Name, Mode=TwoWay}"
                             FontWeight="Bold"
                             FontSize="12"
                             IsVisible="False"
                             MinWidth="80"
                             Padding="2,1"
                             VerticalAlignment="Center"
                             BorderThickness="1"
                             CornerRadius="3"/>
                </StackPanel>

                <!-- Row 1: Separator -->
                <Border Grid.Row="1" Height="1" Margin="0,4"
                        Background="{DynamicResource ThemeBorderBrush}" Opacity="0.4"/>

                <!-- Row 2: Block count + summary -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Border Background="{Binding AggregateStatus, Converter={StaticResource StatusToColor}}"
                                CornerRadius="8" Padding="6,1" Opacity="0.8">
                            <TextBlock Text="{Binding BlockCount, StringFormat={}{0} blocks}"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ContentSummary}"
                               FontSize="9"
                               Foreground="{DynamicResource ThemeTextMutedBrush}"
                               HorizontalAlignment="Center"
                               MaxWidth="160"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
