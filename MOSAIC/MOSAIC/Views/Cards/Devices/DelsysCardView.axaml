<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:MOSAIC.ViewModels.Devices"
    xmlns:models="clr-namespace:MOSAIC.Models.Devices"
    xmlns:scope="clr-namespace:MOSAIC.Visualization.ScopeMonitor"
    xmlns:viz="clr-namespace:MOSAIC.Visualization"
    xmlns:controls="clr-namespace:MOSAIC.Controls"
    xmlns:converters="clr-namespace:MOSAIC.Converters"
    x:Class="MOSAIC.Views.Cards.Devices.DelsysCardView"
    x:DataType="vm:DelsysViewModel">

    <UserControl.Resources>
        <converters:StatusTextToColorConverter x:Key="StatusTextToColor"/>
        <converters:BoolToConnectTextConverter x:Key="BoolToConnectText"/>
        <converters:BoolToStreamTextConverter x:Key="BoolToStreamText"/>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>
    </UserControl.Resources>

    <Border Classes="card">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="cardTitle" Text="{Binding Delsys.Name}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource CategoryDevicesBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="DELSYS" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="4" Padding="6,2"
                                IsVisible="{Binding IsArmed}"
                                Background="{StaticResource StatusNormalBrush}">
                            <TextBlock Text="ARMED" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="4" Padding="6,2"
                                IsVisible="{Binding IsStreaming}"
                                Background="{StaticResource StatusNormalBrush}">
                            <TextBlock Text="STREAMING" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="cardSubtitle" Text="{Binding Delsys.FrequencyText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding Status, Converter={StaticResource StatusTextToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Sensor Discovery — per-sensor rows -->
            <Border Classes="cardSection">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="sectionLabel" Text="SENSORS"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Content="Apply Mode to All"
                                Command="{Binding ApplyModeToAllCommand}"
                                Background="{DynamicResource ThemeSurfaceBrush}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                Padding="12,6" CornerRadius="5" Margin="0,0,8,0"
                                FontWeight="SemiBold" FontSize="10"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Copy the first sensor's mode to all other sensors"/>

                        <Button Grid.Column="2" Content="Scan" Command="{Binding StartScanCommand}"
                                Background="{DynamicResource ThemeSurfaceBrush}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                Padding="16,6" CornerRadius="5"
                                FontWeight="SemiBold" FontSize="11"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Delsys.DiscoveredSensors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DelsysSensorInfo">
                                <Border Background="{DynamicResource ThemeInputBackgroundBrush}"
                                        CornerRadius="6" Padding="8,6" Margin="0,2">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Background="{StaticResource SemiTransparentBadgeBrush}" CornerRadius="4" Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="#{0}">
                                                        <Binding Path="PairNumber"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="2" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="SID {0}">
                                                    <Binding Path="Sid"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3" Text="{Binding Name}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>

                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding SampleModes}"
                                                  SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                                                  Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                  MinWidth="160" FontSize="10"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Pipeline Controls -->
            <Border Classes="cardSection">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionLabel" Text="PIPELINE"/>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="Arm" Command="{Binding ArmCommand}"
                                Background="{StaticResource StatusNormalBrush}" Foreground="White"
                                Padding="12,8" CornerRadius="5"
                                FontWeight="SemiBold" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1" Command="{Binding ToggleStreamCommand}"
                                Content="{Binding IsStreaming, Converter={StaticResource BoolToStreamText}}"
                                Foreground="White" Padding="12,8" CornerRadius="5"
                                FontWeight="SemiBold" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="{StaticResource StatusNormalBrush}"/>
                                </Style>
                                <Style Selector="Button[Tag=True]">
                                    <Setter Property="Background" Value="{StaticResource StatusErrorBrush}"/>
                                </Style>
                            </Button.Styles>
                            <Button.Tag>
                                <Binding Path="IsStreaming"/>
                            </Button.Tag>
                        </Button>

                        <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}"
                                Background="{DynamicResource ThemeSurfaceBrush}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                Padding="12,8" CornerRadius="5"
                                FontWeight="SemiBold" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

                        <Button Grid.Column="3" Content="Export" Command="{Binding ExportCommand}"
                                Background="{DynamicResource ThemeSurfaceBrush}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                Padding="12,8" CornerRadius="5"
                                FontWeight="SemiBold" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Telemetry -->
            <Border Classes="cardSection">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="STREAM INFO"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Device"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Delsys.StreamInfo.DeviceName}"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Status"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Delsys.StreamInfo.PipelineStatus}"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sensors / Channels"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Delsys.StreamInfo.SensorsConnected}"
                                       FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="/" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Delsys.StreamInfo.TotalChannels}"
                                       FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Time"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Delsys.StreamInfo.StreamTime}"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Lost / Frames"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Delsys.StreamInfo.PacketsLost}"
                                       FontSize="11" Foreground="{StaticResource StatusWarningBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="/" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Delsys.StreamInfo.FramesCollected}"
                                       FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- EMG -->
            <Border Classes="cardSection"
                    IsVisible="{Binding Delsys.HasEmg}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="EMG"/>

                    <controls:ScopeLegendControl ItemsSource="{Binding EmgChannelLabels}"/>

                    <viz:VisualizationPanel Source="{Binding VizEmg}"
                                            ScopeVisibleByDefault="True"
                                            ShowScopeViewModeToggle="True"
                                            MinHeight="200"/>
                </StackPanel>
            </Border>

            <!-- Accelerometer -->
            <Border Classes="cardSection"
                    IsVisible="{Binding Delsys.HasAcc}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="ACCELEROMETER"/>

                    <controls:ScopeLegendControl ItemsSource="{Binding AccChannelLabels}"/>

                    <viz:VisualizationPanel Source="{Binding VizAcc}"
                                            ScopeVisibleByDefault="True"
                                            ShowScopeViewModeToggle="True"
                                            MinHeight="200"/>
                </StackPanel>
            </Border>

            <!-- Gyroscope -->
            <Border Classes="cardSection"
                    IsVisible="{Binding Delsys.HasGyro}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="GYROSCOPE"/>

                    <controls:ScopeLegendControl ItemsSource="{Binding GyroChannelLabels}"/>

                    <viz:VisualizationPanel Source="{Binding VizGyro}"
                                            ScopeVisibleByDefault="True"
                                            ShowScopeViewModeToggle="True"
                                            MinHeight="200"/>
                </StackPanel>
            </Border>

            <!-- Orientation -->
            <Border Classes="cardSection"
                    IsVisible="{Binding Delsys.HasOrientation}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="ORIENTATION"/>

                    <controls:ScopeLegendControl ItemsSource="{Binding OrientationChannelLabels}"/>

                    <viz:VisualizationPanel Source="{Binding VizOrientation}"
                                            ScopeVisibleByDefault="True"
                                            ShowScopeViewModeToggle="True"
                                            MinHeight="200"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
