<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MOSAIC.Converters"
    xmlns:viz="clr-namespace:MOSAIC.Visualization"
    xmlns:devices="clr-namespace:MOSAIC.ViewModels.Devices"
    x:Class="MOSAIC.Views.Cards.Devices.StimulusCardView"
    x:DataType="devices:StimulusViewModel">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor" />
        <converters:StatusTextToColorConverter x:Key="StatusTextToColor" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Pulse animation when running -->
        <Style Selector="Border.running-pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="BorderBrush" Value="{StaticResource StatusNormalBrush}" />
                        <Setter Property="Opacity" Value="0.85" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="BorderBrush" Value="{StaticResource CategoryDevicesBrush}" />
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Border Classes="card" Classes.running-pulse="{Binding IsRunning}">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="cardTitle" Text="{Binding Name}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource CategoryDevicesBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="STIMULUS" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- Live state badge -->
                        <Border CornerRadius="4" Padding="6,2"
                                IsVisible="{Binding IsRunning}"
                                Background="{Binding State, Converter={StaticResource StatusTextToColor}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="cardSubtitle" Text="{Binding FrequencyText}" />
                        <TextBlock Classes="cardSubtitle" Text="|" />
                        <TextBlock Classes="cardSubtitle">
                            <Run Text="Tasks: " />
                            <Run Text="{Binding TaskCount}" Foreground="{StaticResource CategoryDevicesBrush}" />
                            <Run Text=" | Capture: " />
                            <Run Text="{Binding CaptureDuration, StringFormat={}{0:F1}s}"
                                 Foreground="{StaticResource CategoryDevicesBrush}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding Block.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Block.Status}" FontWeight="SemiBold"
                               Foreground="White" FontSize="10" TextAlignment="Center" />
                </Border>
            </Grid>

            <Border Classes="divider" />

            <!-- Current status tiles -->
            <Grid ColumnDefinitions="*,*,*,*" HorizontalAlignment="Stretch">
                <!-- STATE -->
                <Border Grid.Column="0" Classes="cardSection" Padding="10,8" Margin="0,0,4,0">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionLabel" Text="STATE" />
                        <TextBlock Text="{Binding State}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource CategoryDevicesBrush}" />
                    </StackPanel>
                </Border>
                <!-- TASK -->
                <Border Grid.Column="1" Classes="cardSection" Padding="10,8" Margin="2,0">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionLabel" Text="TASK" />
                        <TextBlock Text="{Binding CurrentTaskName}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <!-- REMAINING -->
                <Border Grid.Column="2" Classes="cardSection" Padding="10,8" Margin="2,0">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionLabel" Text="REMAINING" />
                        <TextBlock FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource StatusNormalBrush}">
                            <Run Text="{Binding TasksRemaining}" />
                            <Run Text="/" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            <Run Text="{Binding TaskCount}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- CAPTURE -->
                <Border Grid.Column="3" Classes="cardSection" Padding="10,8" Margin="4,0,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionLabel" Text="CAPTURE" />
                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                            <TextBox Text="{Binding CaptureDuration, Mode=TwoWay, StringFormat={}{0:F1}}"
                                     FontSize="16" FontWeight="Bold"
                                     FontFamily="Consolas, Courier New, monospace"
                                     Foreground="{StaticResource CategoryDevicesBrush}"
                                     CaretBrush="{StaticResource CategoryDevicesBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     MinWidth="40"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsNotRunning}" />
                            <TextBlock Text="s" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Task list -->
            <Border Classes="cardSection">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="CONFIGURED TASKS" />
                    <TextBlock Text="Drag to reorder" FontSize="9" Opacity="0.5"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" />

                    <ListBox ItemsSource="{Binding TaskNames}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             DragDrop.AllowDrop="True"
                             DragDrop.Drop="OnTaskDrop"
                             DragDrop.DragOver="OnTaskDragOver">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SemiTransparentBadgeBrush}" CornerRadius="4" Padding="8,4" Margin="2,2"
                                        Cursor="SizeAll"
                                        PointerPressed="OnTaskPointerPressed">
                                    <TextBlock Text="{Binding}" FontSize="11"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Controls -->
            <StackPanel Spacing="8">
                <!-- Shuffle checkbox -->
                <CheckBox Content="Randomize task order (shuffle)"
                          IsChecked="{Binding ShuffleEnabled}"
                          IsEnabled="{Binding IsNotRunning}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          FontSize="13" Padding="8,6" />

                <!-- Action buttons -->
                <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                    <Button Content="▶ Start"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding IsNotRunning}"
                            Background="{StaticResource StatusNormalBrush}"
                            Foreground="White"
                            Padding="12,10" CornerRadius="6" Margin="0,0,4,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="13" FontWeight="Bold" Cursor="Hand" />
                    <Button Content="■ Stop"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding IsRunning}"
                            Background="{StaticResource StatusErrorBrush}"
                            Foreground="White"
                            Padding="12,10" CornerRadius="6" Margin="2,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="13" FontWeight="Bold" Cursor="Hand" />
                    <Button Content="↺ Reset"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding IsNotRunning}"
                            Background="{StaticResource CategoryDevicesBrush}"
                            Foreground="White"
                            Padding="12,10" CornerRadius="6" Margin="4,0,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="13" FontWeight="Bold" Cursor="Hand" />
                </UniformGrid>
            </StackPanel>

            <!-- Target output (visualization) -->
            <Border Classes="cardSection">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="sectionLabel" Text="TARGET OUTPUT" />
                        <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackgroundBrush}"
                                CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding TargetValueText}" FontSize="10"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <viz:VisualizationPanel
                        Source="{Binding Viz}"
                        ScopeVisibleByDefault="True"
                        ShowScopeViewModeToggle="True"
                        MinHeight="140" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
