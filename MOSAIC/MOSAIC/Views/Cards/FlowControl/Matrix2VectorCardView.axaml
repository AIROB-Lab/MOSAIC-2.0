<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MOSAIC.Converters"
    xmlns:vm="clr-namespace:MOSAIC.ViewModels.SignalProcessing"
    xmlns:viz="clr-namespace:MOSAIC.Visualization"
    xmlns:flowControl="clr-namespace:MOSAIC.ViewModels.FlowControl"
    x:Class="MOSAIC.Views.Cards.FlowControl.Matrix2VectorCardView"
    x:DataType="flowControl:Matrix2VectorViewModel">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>

    <Border Classes="card">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Matrix2Vector.Name}"
                                   Classes="cardTitle"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource CategoryFlowControlBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="M→V" FontSize="10" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Matrix2Vector.FrequencyText}"
                                   Classes="cardSubtitle"/>
                        <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Matrix2Vector.FrameLength}"
                                       FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <TextBlock Text=" steps × " FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Matrix2Vector.ChannelCount}"
                                       FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            <TextBlock Text="ch] → Vector[" FontSize="12" Foreground="{StaticResource CategoryFlowControlBrush}"/>
                            <TextBlock Text="{Binding Matrix2Vector.ChannelCount}"
                                       FontSize="12" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Medium"/>
                            <TextBlock Text="]" FontSize="12" Foreground="{StaticResource CategoryFlowControlBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding Matrix2Vector.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Matrix2Vector.Status}"
                               FontWeight="SemiBold" Foreground="White" FontSize="10"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Streaming Info -->
            <Border Classes="cardSection">
                <StackPanel Spacing="6">
                    <TextBlock Text="STREAMING" Classes="sectionLabel"/>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Clock:" Classes="fieldLabel"/>
                        <TextBlock Text="{Binding Matrix2Vector.TimerName}" FontSize="12"
                                   Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Medium"/>
                        <TextBlock Text="→ emits one row (Vector[nCh]) per tick" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Stats -->
                    <Border Background="{DynamicResource ThemeInputBackgroundBrush}"
                            CornerRadius="6" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="ROW" FontSize="8"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Matrix2Vector.CurrentRow}"
                                               FontSize="14" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="/" FontSize="10"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding Matrix2Vector.FrameLength}"
                                               FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeBorderLightBrush}"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="FRAMES" FontSize="8"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Matrix2Vector.FrameCount, StringFormat='{}{0:N0}'}"
                                           FontSize="14" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1" Background="{DynamicResource ThemeBorderLightBrush}"/>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="PUBLISHED" FontSize="8"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Matrix2Vector.PublishCount, StringFormat='{}{0:N0}'}"
                                           FontSize="14" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Visualization -->
            <Border Classes="cardSection">
                <StackPanel Spacing="6">
                    <TextBlock Text="OUTPUT VECTOR" Classes="sectionLabel"/>
                    <viz:VisualizationPanel
                        Source="{Binding Matrix2Vector.Viz}"
                        ScopeVisibleByDefault="True"
                        MinHeight="140"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
