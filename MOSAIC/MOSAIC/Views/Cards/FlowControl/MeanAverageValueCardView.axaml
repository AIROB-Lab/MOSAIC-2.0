<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MOSAIC.Converters"
    xmlns:flowControl="clr-namespace:MOSAIC.ViewModels.FlowControl"
    xmlns:scope="clr-namespace:MOSAIC.Visualization.ScopeMonitor"
    xmlns:visualization="clr-namespace:MOSAIC.Visualization"
    x:Class="MOSAIC.Views.Cards.FlowControl.MeanAverageValueCardView"
    x:DataType="flowControl:MeanAverageValueViewModel">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>

    <Border Classes="card">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding MeanAverageValue.Name}"
                                   Classes="cardTitle"/>
                        <Border Background="{StaticResource CategoryFlowControlBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="MAV" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding MeanAverageValue.FrequencyText}"
                                   Classes="cardSubtitle"/>
                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource ThemeTextDimmedBrush}"/>
                        <TextBlock Text="{Binding MeanAverageValue.ConfigSummary}"
                                   FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding MeanAverageValue.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MeanAverageValue.Status}"
                               FontWeight="SemiBold" Foreground="White" FontSize="10"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Info Section -->
            <Border Classes="cardSection">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="FEATURE EXTRACTION" Classes="sectionLabel"/>
                        <TextBlock Text="Mean Absolute Value" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Formula display -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackgroundBrush}"
                            CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding MeanAverageValue.Description}"
                                   FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}"
                                   FontFamily="Consolas,Monaco,monospace"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Scope Section -->
            <Border Classes="cardSection">
                <StackPanel Spacing="8">
                    <TextBlock Text="MAV OUTPUT" Classes="sectionLabel"/>

                    <Border Background="{DynamicResource ThemeScopeBackgroundBrush}" CornerRadius="6" ClipToBounds="False" MinHeight="140">
                        <visualization:VisualizationPanel Source="{Binding MeanAverageValue.Viz}" ScopeVisibleByDefault="True"
                                                ShowScopeViewModeToggle="True" MinHeight="200"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>