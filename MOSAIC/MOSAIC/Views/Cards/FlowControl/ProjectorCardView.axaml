<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MOSAIC.Converters"
    xmlns:scope="clr-namespace:MOSAIC.Visualization.ScopeMonitor"
    xmlns:vm="clr-namespace:MOSAIC.ViewModels.FlowControl"
    xmlns:visualization="clr-namespace:MOSAIC.Visualization"
    x:Class="MOSAIC.Views.Cards.FlowControl.ProjectorCardView"
    x:DataType="vm:ProjectorViewModel">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>

    <Border Classes="card">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Projector.Name}" Classes="cardTitle"/>
                        <Border Background="{StaticResource CategoryFlowControlBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="PROJECTOR" FontSize="10" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Projector.FrequencyText}" Classes="cardSubtitle"/>
                        <TextBlock Text="•" Classes="cardSubtitle"/>
                        <TextBlock Text="{Binding Projector.ConfigSummary}" Classes="cardSubtitle"
                                   Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" 
                        Background="{Binding Projector.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Projector.Status}" 
                               FontWeight="SemiBold" Foreground="White" FontSize="10"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Index Mapping Section -->
            <Border Classes="cardSection">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="INDEX MAPPING" Classes="sectionLabel"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Projector.OutputChannels}"
                                       FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Bold"/>
                            <TextBlock Text="outputs" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Visual index display -->
                    <Border Background="{DynamicResource ThemeInputBackgroundBrush}" CornerRadius="6" Padding="10,8">
                        <ItemsControl ItemsSource="{Binding Projector.ProjectedIndices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,4,4">
                                        <Border Background="{StaticResource CategoryFlowControlBrush}" 
                                                CornerRadius="4" Padding="8,4" Margin="0,0,2,0" 
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding}" 
                                                       FontSize="12" FontWeight="Bold" 
                                                       Foreground="White" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                       FontFamily="Consolas,Monaco,monospace"/>
                                        </Border>
                                        <!-- Small arrow - use secondary text for visibility in both themes -->
                                        <TextBlock Text="→" 
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                                   VerticalAlignment="Center" Margin="2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    
                    <!-- Editable indices input -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <Border Grid.Column="0" Background="{DynamicResource ThemeInputBackgroundBrush}" 
                                CornerRadius="6" Padding="8,6" 
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                            <TextBox Text="{Binding IndicesText, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12"
                                     FontFamily="Consolas,Monaco,monospace"
                                     PlaceholderText="e.g. 0, 1, 2, 3"
                                     ToolTip.Tip="Enter channel indices separated by commas"/>
                        </Border>
                        <Button Grid.Column="1" 
                                Command="{Binding ApplyIndicesCommand}"
                                Background="{StaticResource CategoryFlowControlBrush}" 
                                Foreground="White"
                                CornerRadius="6" 
                                Padding="12,6"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Content="Apply"/>
                        <Button Grid.Column="2" 
                                Command="{Binding ResetIndicesCommand}"
                                Background="{DynamicResource ThemeSurfaceBrush}" 
                                Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                CornerRadius="6" 
                                Padding="8,6"
                                FontSize="11"
                                Content="↺"
                                ToolTip.Tip="Reset to current"/>
                    </Grid>
                    
                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}" 
                               FontSize="10" Foreground="{StaticResource StatusErrorBrush}" 
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>
                    
                    <!-- Help text -->
                    <TextBlock Text="{Binding Projector.MaxValidIndex, StringFormat=Valid range: 0 to {0}}" 
                               FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               IsVisible="{Binding Projector.InputChannels}"/>
                </StackPanel>
            </Border>

            <!-- Info Row -->
            <Border Classes="cardSection">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="INPUT" Classes="sectionLabel" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Projector.InputChannels}" 
                                       FontSize="14" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold"/>
                            <TextBlock Text="ch" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Big arrow - use category color for emphasis (visible in both themes) -->
                    <TextBlock Grid.Column="1" Text="→" 
                               Foreground="{StaticResource CategoryFlowControlBrush}" 
                               VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="OUTPUT" Classes="sectionLabel" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Projector.OutputChannels}" 
                                       FontSize="14" Foreground="{StaticResource StatusNormalBrush}" FontWeight="Bold"/>
                            <TextBlock Text="ch" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                       VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scope Section -->
            <Border Classes="cardSection">
                <StackPanel Spacing="8">
                    <TextBlock Text="PROJECTED OUTPUT" Classes="sectionLabel"/>
                    
                    <Border Background="{DynamicResource ThemeScopeBackgroundBrush}" CornerRadius="6" ClipToBounds="True" MinHeight="160">
                        <visualization:VisualizationPanel Source="{Binding Projector.Viz}" ScopeVisibleByDefault="True" 
                                                ShowScopeViewModeToggle="True" MinHeight="160"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>