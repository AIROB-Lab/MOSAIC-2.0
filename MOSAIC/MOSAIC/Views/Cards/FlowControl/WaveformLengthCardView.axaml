<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MOSAIC.Converters"
    xmlns:scope="clr-namespace:MOSAIC.Visualization.ScopeMonitor"
    xmlns:vm="clr-namespace:MOSAIC.ViewModels.FlowControl"
    xmlns:visualization="clr-namespace:MOSAIC.Visualization"
    x:Class="MOSAIC.Views.Cards.FlowControl.WaveformLengthCardView"
    x:DataType="vm:WaveformLengthViewModel">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>

    <Border Classes="card">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding WaveformLength.Name}" Classes="cardTitle"/>
                        <Border Background="{StaticResource CategoryFlowControlBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="WL" FontSize="10" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding WaveformLength.FrequencyText}" Classes="cardSubtitle" FontSize="11"/>
                        <TextBlock Text="•" Classes="cardSubtitle" FontSize="11"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WaveformLength.OutputChannels}" 
                                       FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Medium"/>
                            <TextBlock Text=" ch × " FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}"/>
                            <TextBlock Text="{Binding WaveformLength.WindowSize}" 
                                       FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Medium"/>
                            <TextBlock Text=" samples" FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" 
                        Background="{Binding WaveformLength.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WaveformLength.Status}" 
                               FontWeight="SemiBold" Foreground="White" FontSize="10"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Info Section -->
            <Border Classes="cardSection">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="FEATURE EXTRACTION" Classes="sectionLabel"/>
                        <TextBlock Text="Waveform Length" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Cumulative absolute signal changes" FontSize="11"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Formula display -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackgroundBrush}"
                            CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding Description}" 
                                   FontSize="11" Foreground="{StaticResource CategoryFlowControlBrush}" 
                                   FontFamily="Consolas,Monaco,monospace"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Stats Section -->
            <Border Classes="cardSection" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="CHANNELS" Classes="sectionLabel" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding WaveformLength.OutputChannels}" 
                                       FontSize="14" Foreground="{StaticResource CategoryFlowControlBrush}" FontWeight="Bold"/>
                            <TextBlock Text="ch" FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeBorderBrush}" Margin="12,0"/>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="WINDOW" Classes="sectionLabel" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding WaveformLength.WindowSize}" 
                                       FontSize="14" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold"/>
                            <TextBlock Text="samples" FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scope Section -->
            <Border Classes="cardSection" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="WL OUTPUT" Classes="sectionLabel"/>

                    <Border Background="{DynamicResource ThemeScopeBackgroundBrush}" CornerRadius="6" ClipToBounds="True" MinHeight="155">
                        <visualization:VisualizationPanel Source="{Binding WaveformLength.Viz}" ScopeVisibleByDefault="True" 
                                                          ShowScopeViewModeToggle="True" MinHeight="160"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>