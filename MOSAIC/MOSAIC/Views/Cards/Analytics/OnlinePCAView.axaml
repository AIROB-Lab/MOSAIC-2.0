<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MOSAIC.Converters"
    xmlns:analytics="clr-namespace:MOSAIC.ViewModels.Analytics"
    xmlns:controls="clr-namespace:MOSAIC.Controls"
    xmlns:scatter3D="clr-namespace:MOSAIC.Visualization.Scatter3D"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:measure="using:LiveChartsCore.Measure"
    x:Class="MOSAIC.Views.Cards.Analytics.OnlinePCAView"
    x:DataType="analytics:OnlinePCAViewModel">

    <UserControl.Resources>
       <converters:StatusToColorConverter x:Key="StatusToColor"/>
       <measure:Margin x:Key="ScatterMargin" Left="50" Top="20" Right="50" Bottom="50"/>
    </UserControl.Resources>

    <Border Classes="card" MinHeight="750">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*" RowSpacing="12">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="cardTitle" Text="{Binding OnlinePCA.Name}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource CategoryAnalyticsBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="PCA" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="cardSubtitle" Text="{Binding OnlinePCA.FrequencyText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding OnlinePCA.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OnlinePCA.Status}" FontWeight="SemiBold" Foreground="White" FontSize="11"
                               TextAlignment="Center"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Classes="divider"/>

            <!-- Display points + view toggles -->
            <Border Grid.Row="2" Classes="cardSection">
                <Grid ColumnDefinitions="*,Auto">
                    <controls:NumericParameterRow Grid.Column="0" Label="Display Points:" Minimum="100" Maximum="5000"
                                                  Increment="100" Value="{Binding MaxScatterPoints}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                                Margin="16,0,0,0" IsVisible="{Binding Is3D}">
                        <TextBlock Classes="fieldLabel" Text="Show:"/>
                        <CheckBox Content="3D" IsChecked="{Binding Show3DView}" FontSize="12"/>
                        <CheckBox Content="2D" IsChecked="{Binding Show2DView}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3D Scatter (only when k=3, and not toggled off) -->
            <Border Grid.Row="3" Classes="cardSection" IsVisible="{Binding Show3DPane}">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="3D Projection" FontSize="16" FontWeight="Bold"
                                  Foreground="{StaticResource CategoryAnalyticsBrush}"/>
                        <TextBlock Grid.Column="1" Text="drag to rotate" FontSize="11"
                                  Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <scatter3D:Scatter3DView Grid.Row="1" Scatter="{Binding Scatter3D}"/>
                </Grid>
            </Border>

            <!-- PC Scatter (PC1 vs PC2) -->
            <Border Grid.Row="4" Classes="cardSection" Height="450" IsVisible="{Binding Show2DPane}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="{Binding ChartTitle}" FontSize="16" FontWeight="Bold"
                                  Foreground="{StaticResource CategoryAnalyticsBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SampleCountText}" FontSize="12"
                                  Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="16,0"/>
                        <Border Grid.Column="2" Background="{DynamicResource ThemeInputBackgroundBrush}"
                                CornerRadius="6" Padding="10,5" IsVisible="{Binding OnlinePCA.IsStable}">
                            <TextBlock Text="STABLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CategoryAnalyticsBrush}"/>
                        </Border>
                    </Grid>
                    <lvc:CartesianChart Grid.Row="1"
                                       Series="{Binding ScatterSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                       TooltipPosition="Hidden" ZoomMode="Both" DrawMargin="{StaticResource ScatterMargin}"/>
                </Grid>
            </Border>

            <!-- Explained variance -->
            <Border Grid.Row="5" Classes="cardSection">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionLabel" Text="EXPLAINED VARIANCE"/>
                    <controls:RatioBarRow Label="PC1" Value="{Binding Pc1Variance}"/>
                    <controls:RatioBarRow Label="PC2" Value="{Binding Pc2Variance}"/>
                    <controls:RatioBarRow Label="PC3" Value="{Binding Pc3Variance}" IsVisible="{Binding Is3D}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
