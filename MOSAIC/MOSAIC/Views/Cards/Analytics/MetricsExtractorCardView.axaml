<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MOSAIC.Converters"
    xmlns:vm="clr-namespace:MOSAIC.ViewModels.Analytics"
    xmlns:visualization="clr-namespace:MOSAIC.Visualization"
    x:Class="MOSAIC.Views.Cards.Analytics.MetricsExtractorCardView"
    x:DataType="vm:MetricsExtractorViewModel">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>

    <Border Classes="card">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="cardTitle" Text="{Binding MetricsExtractor.Name}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource CategoryAnalyticsBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="METRICS" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="cardSubtitle" Text="{Binding MetricsExtractor.FrequencyText}"/>
                        <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MetricsExtractor.OutputChannels}" 
                                       FontSize="12" Foreground="{StaticResource CategoryAnalyticsBrush}" FontWeight="Medium"/>
                            <TextBlock Text=" ch × " FontSize="12" Foreground="{StaticResource CategoryAnalyticsBrush}"/>
                            <TextBlock Text="{Binding MetricsExtractor.WindowSize}" 
                                       FontSize="12" Foreground="{StaticResource CategoryAnalyticsBrush}" FontWeight="Medium"/>
                            <TextBlock Text=" samples" FontSize="12" Foreground="{StaticResource CategoryAnalyticsBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Status badge - uses converter -->
                <Border Grid.Column="1" 
                        Background="{Binding MetricsExtractor.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MetricsExtractor.Status}" 
                               FontWeight="SemiBold" Foreground="White" FontSize="10"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Info Section -->
            <Border Classes="cardSection">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="sectionLabel" Text="AMPLITUDE METRIC"/>
                        <TextBlock Text="{Binding MetricsExtractor.Metric}" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" 
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Formula display -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackgroundBrush}" 
                            CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Formula}" 
                                   FontSize="12" Foreground="{StaticResource CategoryAnalyticsBrush}" 
                                   FontFamily="Consolas,Monaco,monospace"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Configuration Section -->
            <Border Classes="cardSection">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionLabel" Text="CONFIGURATION"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <!-- Metric Type Selector -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="Metric Type"/>
                            <ComboBox ItemsSource="{Binding MetricTypes}"
                                      SelectedItem="{Binding MetricsExtractor.Metric, Mode=TwoWay}"
                                      Background="{DynamicResource ThemeInputBackgroundBrush}"
                                      BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                      CornerRadius="6"
                                      Padding="8,6"
                                      MinHeight="32"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        
                        <!-- Stats -->
                        <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackgroundBrush}" 
                                CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="sectionLabel" Text="CHANNELS" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding MetricsExtractor.OutputChannels}" 
                                                   FontSize="14" Foreground="{StaticResource CategoryAnalyticsBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="ch" FontSize="9" 
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                                   VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeBorderLightBrush}"/>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="sectionLabel" Text="WINDOW" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding MetricsExtractor.WindowSize}" 
                                                   FontSize="14" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="pts" FontSize="9" 
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                                   VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="cardSection">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="EMG SIGNAL"/>
                    <visualization:VisualizationPanel 
                        Source="{Binding MetricsExtractor.Viz}"
                        ScopeVisibleByDefault="True"
                        ShowScopeViewModeToggle="True"
                        MinHeight="140"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
