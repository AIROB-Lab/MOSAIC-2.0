<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MOSAIC.Converters"
    xmlns:analytics="clr-namespace:MOSAIC.ViewModels.Analytics"
    xmlns:controls="clr-namespace:MOSAIC.Controls"
    xmlns:scatter3d="clr-namespace:MOSAIC.Visualization.Scatter3D"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:measure="using:LiveChartsCore.Measure"
    x:Class="MOSAIC.Views.Cards.Analytics.SupervisedUMAPView"
    x:DataType="analytics:SupervisedUMAPViewModel">

    <UserControl.Resources>
       <converters:StatusToColorConverter x:Key="StatusToColor"/>
       <measure:Margin x:Key="ScatterMargin" Left="50" Top="20" Right="50" Bottom="50"/>
    </UserControl.Resources>

    <Border Classes="card">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="*" RowSpacing="12">

            <!-- Row 0: Header + Status -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SupervisedUMAP.Name}" Classes="cardTitle"
                              VerticalAlignment="Center"/>
                    <Border Background="{StaticResource CategoryAnalyticsBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="UMAP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border Background="{StaticResource StatusNormalBrush}" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding SupervisedUMAP.IsFitted}">
                        <TextBlock Text="FITTED" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" Classes="cardSubtitle"
                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding SupervisedUMAP.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SupervisedUMAP.Status}" FontWeight="SemiBold" Foreground="White" FontSize="11"/>
                </Border>
            </Grid>

            <!-- Row 1: Params + Capture in one compact row -->
            <Border Grid.Row="1" Classes="cardSection">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <!-- n_neighbors -->
                    <TextBlock Grid.Column="0" Text="k:" Classes="fieldLabel" VerticalAlignment="Center"/>
                    <controls:SafeNumericUpDown Grid.Column="1" Value="{Binding SupervisedUMAP.NNeighbors}" Minimum="2" Maximum="200"
                                  Increment="1" Width="110" FontSize="12" Padding="6,2"
                                  IsEnabled="{Binding !SupervisedUMAP.IsFitted}"/>
                    <!-- min_dist -->
                    <TextBlock Grid.Column="2" Text="d:" Classes="fieldLabel" VerticalAlignment="Center"
                              Margin="8,0,0,0"/>
                    <controls:SafeNumericUpDown Grid.Column="3" Value="{Binding SupervisedUMAP.MinDist}" Minimum="0.0" Maximum="1.0"
                                  Increment="0.05" FormatString="F2" Width="110" FontSize="12" Padding="6,2"
                                  IsEnabled="{Binding !SupervisedUMAP.IsFitted}" HorizontalAlignment="Left"/>
                    <!-- Capture controls -->
                    <TextBox Grid.Column="4" Text="{Binding LabelInput}" Width="140"
                            PlaceholderText="label" FontSize="12" Padding="8,6"
                            IsEnabled="{Binding !SupervisedUMAP.IsCapturing}"/>
                    <Button Grid.Column="5" Content="Capture" Command="{Binding StartCaptureCommand}"
                            IsEnabled="{Binding !SupervisedUMAP.IsCapturing}"
                            Background="{StaticResource CategoryAnalyticsBrush}" Foreground="White"
                            Padding="12,6" CornerRadius="4" FontSize="12" FontWeight="Bold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="6" Content="Stop" Command="{Binding StopCaptureCommand}"
                            IsEnabled="{Binding SupervisedUMAP.IsCapturing}"
                            Background="{StaticResource StatusErrorBrush}" Foreground="White"
                            Padding="12,6" CornerRadius="4" FontSize="12" FontWeight="Bold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="7" Content="Fit" Command="{Binding FitModelCommand}"
                            IsEnabled="{Binding HasClusters}"
                            Background="{StaticResource StatusNormalBrush}" Foreground="White"
                            Padding="16,6" CornerRadius="4" FontSize="12" FontWeight="Bold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Button.Styles>
                            <Style Selector="Button:disabled">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <!-- View toggles: only meaningful in 3-component mode -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                                Margin="16,0,0,0" IsVisible="{Binding Is3D}">
                        <TextBlock Classes="fieldLabel" Text="Show:"/>
                        <CheckBox Content="3D" IsChecked="{Binding Show3DView}" FontSize="12"/>
                        <CheckBox Content="2D" IsChecked="{Binding Show2DView}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Capture status bar (only when capturing) -->
            <Border Grid.Row="2" Background="{StaticResource CategoryAnalyticsBrush}" CornerRadius="6" Padding="10,6"
                   IsVisible="{Binding SupervisedUMAP.IsCapturing}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Center">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Style.Animations>
                                    <Animation Duration="0:0:0.8" IterationCount="Infinite">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Ellipse.Styles>
                    </Ellipse>
                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="White">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Capturing '{0}' — {1} points">
                                <Binding Path="SupervisedUMAP.CurrentLabel"/>
                                <Binding Path="SupervisedUMAP.CurrentCaptureCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Row 3: Cluster legend (compact horizontal) -->
            <Border Grid.Row="3" Classes="cardSection"
                    IsVisible="{Binding HasClusters}">
                <Grid ColumnDefinitions="*,Auto">
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding ClusterInfoList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ThemeInputBackgroundBrush}" CornerRadius="4"
                                        Padding="8,4" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding Label}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding PointCount}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <Button Content="✕"
                                                Command="{Binding $parent[UserControl].((analytics:SupervisedUMAPViewModel)DataContext).ClearClusterCommand}"
                                                CommandParameter="{Binding Label}"
                                                Width="18" Height="18" FontSize="10" Padding="0"
                                                Background="Transparent" Foreground="{StaticResource StatusErrorBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="1" Content="Clear All" Command="{Binding ClearAllClustersCommand}"
                            Background="Transparent" Foreground="{StaticResource StatusErrorBrush}"
                            Padding="8,4" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Row 4: Main visualization area. UniformGrid lays out only its VISIBLE children,
                 so a hidden pane gives up its column and the remaining one spans the full width;
                 with Components=2 that leaves the 2D chart alone, exactly as before. -->
            <UniformGrid Grid.Row="4" Rows="1" MinHeight="400">
                <Border Classes="cardSection" Padding="8" Margin="0,0,12,0"
                        IsVisible="{Binding Show3DPane}">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="3D Projection" FontSize="14" FontWeight="Bold"
                                      Foreground="{StaticResource CategoryAnalyticsBrush}"/>
                            <TextBlock Grid.Column="1" Text="drag to rotate" FontSize="10"
                                      Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        </Grid>
                        <scatter3d:Scatter3DView Grid.Row="1" Scatter="{Binding Scatter3D}"/>
                    </Grid>
                </Border>
                <Border Classes="cardSection" Padding="8"
                        IsVisible="{Binding Show2DPane}">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{Binding ChartTitle}" FontSize="14" FontWeight="Bold"
                                      Foreground="{StaticResource CategoryAnalyticsBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SampleCountText}" FontSize="11"
                                      Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        </Grid>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding ScatterSeries}"
                                           XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                           TooltipPosition="Hidden" ZoomMode="Both"
                                           DrawMargin="{StaticResource ScatterMargin}"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Row 5: Points slider -->
            <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Display:" Classes="fieldLabel" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="100" Maximum="5000" Value="{Binding MaxScatterPoints}"
                        TickFrequency="100" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding MaxScatterPoints, StringFormat='{}{0:N0}'}" FontSize="11"
                          Foreground="{StaticResource CategoryAnalyticsBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
