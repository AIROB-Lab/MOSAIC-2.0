<cards:PopoutCardBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:MOSAIC.ViewModels"
    xmlns:converters="clr-namespace:MOSAIC.Converters"
    xmlns:scopeMonitor="clr-namespace:MOSAIC.Visualization.ScopeMonitor"
    xmlns:heatMap="clr-namespace:MOSAIC.Visualization.Heatmap"
    xmlns:signalProcessing="clr-namespace:MOSAIC.ViewModels.SignalProcessing"
    xmlns:visualization="clr-namespace:MOSAIC.Visualization"
    xmlns:cards="clr-namespace:MOSAIC.Views.Cards"
    xmlns:controls="clr-namespace:MOSAIC.Controls"
    x:Class="MOSAIC.Views.Cards.SignalProcessing.FunctionCardView"
    x:DataType="signalProcessing:FunctionViewModel">

    <cards:PopoutCardBase.Resources>
       <converters:StatusToColorConverter x:Key="StatusToColor"/>
       <converters:RunningToImageConverter x:Key="BoolToStartStopImage"/>
    </cards:PopoutCardBase.Resources>
    
    <Border Classes="card" MinHeight="300">

        <StackPanel Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="cardTitle" Text="{Binding Function.Name}"/>
                        <Border Background="{StaticResource CategorySignalProcessingBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="FUNCTION" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="cardSubtitle" Text="{Binding Function.FrequencyText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding Function.Status, Converter={StaticResource StatusToColor}}"
                        CornerRadius="12"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Function.Status}"
                               FontWeight="SemiBold"
                               Foreground="White"
                               FontSize="10"/>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Function Configuration Panel -->
            <Border Classes="cardSection">
                <StackPanel Spacing="12">
                    <TextBlock Classes="sectionLabel" Text="CONFIGURATION"/>

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,*"
                          RowSpacing="10" ColumnSpacing="12">

                        <!-- Function Type Dropdown -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Classes="fieldLabel"
                                   Text="Type:"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding FunctionTypes}"
                                  SelectedItem="{Binding Function.FunctionType}"
                                  MinWidth="120"
                                  Background="{DynamicResource ThemeInputBackgroundBrush}"
                                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                  FontSize="13"/>
                        
                        <!-- Param1 Input -->
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Classes="fieldLabel"
                                   Text="{Binding Param1Label, StringFormat='{}{0}:'}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowParam1}"/>
                        <controls:SafeNumericUpDown Grid.Row="0" Grid.Column="3"
                                       Value="{Binding Function.Param1}"
                                       Minimum="-1000000"
                                       Maximum="1000000"
                                       Increment="0.1"
                                       FormatString="F3"
                                       MinWidth="100"
                                       Background="{DynamicResource ThemeInputBackgroundBrush}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="13"
                                       IsVisible="{Binding ShowParam1}"/>
                        
                        <!-- Param2 Input -->
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Classes="fieldLabel"
                                   Text="{Binding Param2Label, StringFormat='{}{0}:'}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowParam2}"/>
                        <controls:SafeNumericUpDown Grid.Row="1" Grid.Column="3"
                                       Value="{Binding Function.Param2}"
                                       Minimum="-1000000"
                                       Maximum="1000000"
                                       Increment="0.1"
                                       FormatString="F3"
                                       MinWidth="100"
                                       Background="{DynamicResource ThemeInputBackgroundBrush}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="13"
                                       IsVisible="{Binding ShowParam2}"/>
                        
                        <!-- Current function display -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource CategorySignalProcessingBrush}"
                                   FontSize="12"
                                   FontStyle="Italic">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="f(x) = {0}">
                                    <Binding Path="Function.FunctionType"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Visualization -->
            <Border Classes="cardSection">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="OUTPUT"/>
                    <visualization:VisualizationPanel 
                        Source="{Binding Viz}"
                        ScopeVisibleByDefault="True"
                        ShowScopeViewModeToggle="True"
                        MinHeight="140"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</cards:PopoutCardBase>
