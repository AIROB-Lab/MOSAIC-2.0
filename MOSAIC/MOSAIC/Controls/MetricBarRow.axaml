<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             x:Class="MOSAIC.Controls.MetricBarRow">

    <!-- label · bar (filled by |Value|/Max) · raw value. For unbounded metrics (kurtosis,
         separability) the bar shows relative magnitude; the number shows the actual value. -->
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Binding Label, ElementName=Root}" Width="36"
                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>

        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fraction, ElementName=Root}"
                     Height="8" CornerRadius="4" VerticalAlignment="Center"
                     Background="{DynamicResource ThemeInputBackgroundBrush}"
                     Foreground="{StaticResource CategoryAnalyticsBrush}"/>

        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Root, StringFormat='{}{0:F2}'}" Width="56"
                   FontSize="13" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"
                   Foreground="{StaticResource CategoryAnalyticsBrush}"/>
    </Grid>
</UserControl>
